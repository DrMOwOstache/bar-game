; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Bar_game"
run/main_scene="uid://dva06xo6srdqd"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://cvqcccyrpughf"

[autoload]

DialogueManager="*uid://c3rodes2l3gxb"

[dialogue_manager]

editor/wrap_long_lines=true

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Bar_game"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "gray",
"res://assets/": "red",
"res://scenes/": "purple",
"res://scripts/": "gray"
}

[internationalization]

locale/translations_pot_files=PackedStringArray("res://resources/dialogue/office_worker.dialogue", "res://resources/dialogue/military_officer.dialogue")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
