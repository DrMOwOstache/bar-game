script = ExtResource("3_ecua5")
drink_name = "Gin"
drink_description = "Distilled alcoholic drink flavoured with juniper berries and other botanical ingredients. It originated as a medicinal liquor made by monks and alchemists in the 12th Century in Salerno, Italy. The modern gin was modified in Flanders and the Netherlands to provide aqua vita from distillates of grapes and grains, becoming an object of commerce in the spirits industry."
